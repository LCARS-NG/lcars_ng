{#
/**
 * @file
 * LCARS heading, as #page-title in the Drupal 6 theme LCNG.
 *
 * @deprecated in lcars_ng:1.0.8 and is removed from lcars_ng:2.0.0. No
 *   template of the theme uses it since Canvas left lcars-ng.org, so it is no
 *   longer tested there (#29, 29.10.2026).
 */
#}
{% set level = level|default(2) %}
{% set classes = [
  'lcars-heading',
  'lcars-heading--' ~ style|default('bar'),
  'lcars-heading--' ~ color|default('accent'),
] %}
<div{{ attributes.addClass(classes) }}>
  <h{{ level }} class="lcars-heading__text">{{ heading_text }}</h{{ level }}>
</div>
