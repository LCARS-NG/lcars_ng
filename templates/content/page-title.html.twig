{#
/**
 * @file
 * Theme override for page titles.
 *
 * Available variables:
 * - title_attributes: HTML attributes for the page title element.
 * - title_prefix: Additional output populated by modules, intended to be
 *   displayed in front of the main title tag that appears in the template.
 * - title: The page title, for use in the actual content.
 * - title_suffix: Additional output populated by modules, intended to be
 *   displayed after the main title tag that appears in the template.
 * - title_hidden: Whether the title and its bar are visually hidden
 *   (LcarsNgHooks::preprocessPageTitle(), the pages to log in and to reset
 *   the password).
 * - title_tag: The element of the title, h1 unless the bar names the type of
 *   the content whose title is the heading of the page (node.html.twig), or
 *   unless the title of the content follows below (content_title).
 * - content_title: The title of the content as the heading of the page below
 *   the bar, styled as on the page of the content (the revisions and the
 *   latest version of content; LcarsNgHooks::preprocessPageTitle()).
 */
#}
{% set tag = title_tag|default('h1') %}
{{ title_prefix }}
{% if title %}
  {# The title cuts into a bar, as #page-title in the Drupal 6 theme LCNG. #}
  <div{{ create_attribute({'class': ['lcars-title', title_hidden ? 'visually-hidden']}) }}>
    <{{ tag }}{{ title_attributes.addClass('page-title') }}>{{ title }}</{{ tag }}>
  </div>
{% endif %}
{% if content_title %}
  {{ attach_library('lcars_ng/node') }}
  <h1 class="node__title">{{ content_title }}</h1>
{% endif %}
{{ title_suffix }}
