{#
/**
 * @file
 * Theme override for an individual form element.
 *
 * Available variables for all fields:
 * - multiple: Whether there are multiple instances of the field.
 *
 * Available variables for single cardinality fields:
 * - elements: Form elements to be rendered.
 *
 * Available variables when there are multiple fields.
 * - table: Table of field items.
 * - description: The description element containing the following properties:
 *   - content: The description content of the form element.
 *   - attributes: HTML attributes to apply to the description container.
 * - button: "Add another item" button.
 * - legend: The label of the field, from the head of the table, where it
 *   stays for screen readers only (LcarsNgHooks::preprocessFieldMultipleValueForm()).
 * - legend_attributes: HTML attributes for the label (the required marker).
 *
 * A fieldset instead of core's div, with the label as its legend: in node
 * forms it stands in the upper line of the box (forms.css).
 *
 * @see \Drupal\Core\Field\FieldPreprocess::preprocessFieldMultipleValueForm()
 */
#}
{% if multiple %}
  {%
    set classes = [
      'js-form-item',
      'form-item',
      'lcars-multiple',
    ]
  %}
  <fieldset{{ attributes.addClass(classes) }}>
    {% if legend %}
      <legend><span{{ legend_attributes }}>{{ legend }}</span></legend>
    {% endif %}
    {{ table }}
    {% if description.content %}
      <div{{ description.attributes.addClass('description') }} >{{ description.content }}</div>
    {% endif %}
    {% if button %}
      <div class="clearfix">{{ button }}</div>
    {% endif %}
  </fieldset>
{% else %}
  {% for element in elements %}
    {{ element }}
  {% endfor %}
{% endif %}
