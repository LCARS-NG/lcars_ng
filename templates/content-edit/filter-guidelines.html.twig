{#
/**
 * @file
 * Theme override for guidelines for a text format.
 *
 * Available variables:
 * - format: Contains information about the current text format, including the
 *   following:
 *   - name: The name of the text format, potentially unsafe and needs to be
 *     escaped.
 *   - format: The machine name of the text format, e.g. 'basic_html'.
 * - attributes: HTML attributes for the containing element.
 * - tips: Descriptions and a CSS ID in the form of 'module-name/filter-id'
 *   (only used when 'long' is TRUE) for each filter in one or more text
 *   formats.
 *
 * The tips are collapsed below the text format, opened by a small link
 * (#48, variant C, user decision 03.11.2026): the allowed tags of a format
 * took a quarter of a phone screen in the middle of the form. filter.js hides
 * the heading and shows the guidelines of the selected format only; the
 * summary is no heading and stays.
 *
 * @see \Drupal\filter\FilterThemeHooks::preprocessFilterGuidelines()
 */
#}
{%
  set classes = [
    'filter-guidelines-item',
    'filter-guidelines-' ~ format.id,
  ]
%}
{% set tips_markup = tips|render %}
<div{{ attributes.addClass(classes) }}>
  <h4 class="label">{{ format.label }}</h4>
  {% if tips_markup|trim is not empty %}
    <details class="lcars-format-help">
      <summary>{{ 'Formatting help'|t }}</summary>
      {{ tips_markup }}
    </details>
  {% endif %}
</div>
