{#
/**
 * @file
 * Theme override for a block in the right sidebar: an LCARS panel with the
 * block title cut into its ceiling, as block-right.tpl.php (.ceilingTop and
 * .innerframeTop) in the Drupal 6 theme LCNG.
 *
 * The suggestion block__REGION comes from LcarsNgHooks.
 *
 * @see block.html.twig
 */
#}
{%
  set classes = [
    'block',
    'block-' ~ configuration.provider|clean_class,
    'block-' ~ plugin_id|clean_class,
  ]
%}
{% embed 'lcars_ng:panel' with {
  attributes: attributes.addClass(classes),
  label: label,
  color: 'frame',
  block_content: content,
  title_prefix: title_prefix,
  title_suffix: title_suffix,
} only %}
  {% block content %}
    {{ title_prefix }}
    {{ title_suffix }}
    {{ block_content }}
  {% endblock %}
{% endembed %}
