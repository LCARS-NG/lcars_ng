{#
/**
 * @file
 * Theme override for the login panel.
 *
 * Used for the account pages (log in, register, reset password) and, with the
 * theme setting front_page_login, for the front page of anonymous visitors, as
 * page-userauth.tpl.php and page-front-anonymous.tpl.php in the Drupal 6 theme
 * LCNG: a bar at the top and the bottom of the window, the site name and the
 * form centred between them. The footer region (privacy policy, imprint,
 * consent settings) sits above the bottom bar, as on the other pages.
 *
 * Available variables:
 * - login_form: The user login form, set on the front page of anonymous
 *   visitors (LcarsNgHooks::preprocessPage()). On the account pages the form
 *   is the main content.
 * - reset_password_url: The password reset form, set with login_form when the
 *   form is available.
 *
 * @see page.html.twig
 * @see \Drupal\lcars_ng\Hook\LcarsNgHooks
 */
#}
{{ attach_library('lcars_ng/login') }}
<div{{ create_attribute({'class': ['lcars-login', page.footer ? 'lcars-login--foot']}) }}>
  <div class="lcars-login__bar"></div>

  <main class="lcars-login__panel lcars-box">
    <a id="main-content" tabindex="-1"></a>{# link is in html.html.twig #}
    {{ page.header }}
    {{ page.highlighted }}
    {% if login_form %}
      {{ login_form }}
      {% if reset_password_url %}
        <p class="lcars-login__links">
          <a href="{{ reset_password_url }}">{{ 'Reset your password'|t }}</a>
        </p>
      {% endif %}
    {% else %}
      {{ page.content }}
    {% endif %}
  </main>

  {% if page.footer %}
    <footer class="lcars-login__foot">
      {{ page.footer }}
    </footer>
  {% endif %}

  <div class="lcars-login__bar"></div>
</div>
