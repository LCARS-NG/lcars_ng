{#
/**
 * @file
 * Theme override to display a single page in the LCARS frame.
 *
 * The frame follows the Drupal 6 theme LCNG: a top-left elbow with the header
 * bar, the sidebar menu below it, the content to its right and a bottom-left
 * elbow around the footer. Layout and full-height sidebar come from CSS grid
 * (css/lcars/frame.css), no JavaScript.
 *
 * The doctype, html, head and body tags are not in this template. Instead they
 * can be found in the html.html.twig template in this directory.
 *
 * Available variables:
 * - is_front: A flag indicating if the current page is the front page.
 * - logged_in: A flag indicating if the user is registered and signed in.
 *
 * Regions:
 * - page.header: The header bar (site branding).
 * - page.breadcrumb: Inside the curve of the top elbow.
 * - page.sidebar: The sidebar menu.
 * - page.highlighted: Status messages.
 * - page.help: Dynamic help text, mostly for admin pages.
 * - page.content: The main content of the current page.
 * - page.sidebar_second: Items for the right sidebar.
 * - page.footer: Inside the curve of the bottom elbow.
 *
 * @see page--login.html.twig
 * @see html.html.twig
 */
#}
<div class="lcars-frame">

  <header class="lcars-head">
    <div class="lcars-head__bar">
      {{ page.header }}
    </div>
    <div class="lcars-head__inner">
      {{ page.breadcrumb }}
    </div>
  </header>

  <div class="lcars-sidebar">
    {{ page.sidebar }}
  </div>

  <main class="lcars-main">
    <a id="main-content" tabindex="-1"></a>{# link is in html.html.twig #}
    {{ page.highlighted }}
    {{ page.help }}
    {{ page.content }}
  </main>

  {% if page.sidebar_second %}
    <aside class="lcars-aside">
      {{ page.sidebar_second }}
    </aside>
  {% endif %}

  <footer class="lcars-foot">
    <div class="lcars-foot__inner">
      {{ page.footer }}
    </div>
  </footer>

</div>{# /.lcars-frame #}
